# ============================================================
#  Pipoca - exemplo de configuracao
#  Copie para .env  ->  copy .env.example .env   (Windows)
# ============================================================

# ---------- Identidade ----------
BOT_NAME=Pipoca
# Quem mantem o bot. Aparece nos creditos da figurinha.
AUTHOR=

# ---------- WhatsApp ----------
# Prefixo dos comandos.
PREFIX=/
# Fuso usado nos logs e nas respostas de data/hora.
TIMEZONE=America/Sao_Paulo
# true  = tambem responde em grupos (somente quando mencionada/citada)
# false = ignora grupos por completo
GROUPS=true
# Nome gravado como autor da figurinha.
STICKER_AUTHOR=Pipoca
# Nome do pacote de figurinhas.
STICKER_PACK=Pipoca

# ---------- LLM (qualquer API compativel com OpenAI) ----------
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
MODEL=gpt-4o-mini
FALLBACK_MODEL=gpt-4o-mini

# ---------- Visao ----------
# true = manda imagens recebidas para o modelo multimodal.
VISION_ENABLED=false

# ---------- Avatar ----------
# true = define a foto de perfil do WhatsApp com a arte da persona no boot.
# Usa o arquivo indicado em persona.avatar.imagePath (padrao: assets/pipoca.png).
# Fica desligado por padrao porque altera algo visivel na sua conta.
SET_PROFILE_PICTURE=false

# ---------- Comportamento ----------
# Quantas mensagens do historico entram no contexto enviado ao modelo.
HISTORY_LIMIT=15
# Mostra o prompt completo no console (debug). Nao use em producao.
DEBUG_PROMPT=false

# ---------- ffmpeg ----------
# Opcional. Deixe vazio para usar o ffmpeg do PATH.
# No Windows, se o ffmpeg nao estiver no PATH: FFMPEG_PATH=./ffmpeg.exe
FFMPEG_PATH=

# ---------- Chrome ----------
# Opcional. Deixe VAZIO para o bot achar sozinho o Chrome instalado na
# maquina (recomendado no Windows/macOS/Linux com Chrome).
# Preencha apenas se o Chrome estiver num lugar fora do padrao.
# Se nao achar nenhum, o puppeteer usa o Chromium que ele mesmo baixa:
#   npx puppeteer browsers install chrome
CHROME_PATH=
